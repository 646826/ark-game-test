{
  "name": "clockwork-conservatory",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Cinematic Arkadium-ready botanical circuit puzzle.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs dist",
    "preview": "node scripts/serve.mjs dist",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "smoke": "python3 scripts/smoke_browser.py",
    "ci": "npm run check && npm run test && npm run art:check && npm run build",
    "perf": "python3 scripts/performance_browser.py",
    "release": "npm run ci && npm run smoke && npm run cinematic:smoke && npm run perf",
    "art:generate": "python3 scripts/generate_cinematic_assets.py && python3 scripts/generate_cinematic_v3_assets.py",
    "art:check": "python3 scripts/test_art_quality.py",
    "cinematic:smoke": "python3 scripts/cinematic_smoke.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
