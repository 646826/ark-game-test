{
  "name": "clockwork-conservatory",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Premium Arkadium-ready botanical circuit puzzle.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs dist",
    "preview": "node scripts/serve.mjs dist",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "smoke": "python3 scripts/smoke_browser.py",
    "ci": "npm run check && npm run test && npm run build",
    "perf": "python3 scripts/performance_browser.py",
    "release": "npm run ci && npm run smoke && npm run perf"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
